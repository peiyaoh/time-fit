{
  "name": "@time-fit/integrations",
  "version": "0.0.0",
  "private": true,
  "description": "Injected delivery actions for @time-fit/core",
  "type": "module",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peiyaoh/time-fit.git",
    "directory": "packages/integrations"
  },
  "homepage": "https://github.com/peiyaoh/time-fit/tree/main/packages/integrations#readme",
  "bugs": "https://github.com/peiyaoh/time-fit/issues",
  "types": "./types/desktop.d.ts",
  "exports": {
    "./desktop": {
      "types": "./types/desktop.d.ts",
      "default": "./src/desktop.js"
    },
    "./twilio": {
      "types": "./types/twilio.d.ts",
      "default": "./src/twilio.js"
    },
    "./mailjet": {
      "types": "./types/mailjet.d.ts",
      "default": "./src/mailjet.js"
    }
  },
  "files": [
    "src",
    "types",
    "/README.md",
    "/LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "build:types": "tsc --project tsconfig.types.json",
    "prepack": "yarn build:types",
    "postpack": "node -e \"require('node:fs').rmSync('types', { recursive: true, force: true })\""
  },
  "peerDependencies": {
    "@time-fit/core": ">=0.0.0 <1"
  },
  "devDependencies": {
    "@time-fit/core": "workspace:*",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "typescript": "^5.9.3"
  }
}
