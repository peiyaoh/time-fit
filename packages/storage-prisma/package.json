{
  "name": "@time-fit/storage-prisma",
  "version": "0.0.0",
  "private": true,
  "description": "Injected Prisma storage ports for @time-fit/core",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "prisma",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
