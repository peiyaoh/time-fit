{
  "name": "@time-fit/storage-prisma",
  "version": "0.0.0",
  "private": true,
  "description": "Injected Prisma storage ports for @time-fit/core",
  "type": "module",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peiyaoh/time-fit.git",
    "directory": "packages/storage-prisma"
  },
  "homepage": "https://github.com/peiyaoh/time-fit/tree/main/packages/storage-prisma#readme",
  "bugs": "https://github.com/peiyaoh/time-fit/issues",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "types",
    "prisma",
    "/README.md",
    "/LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "yarn validate:schemas && yarn prisma:generate:test && cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "yarn validate:schemas && yarn prisma:generate:test && cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "validate:schemas": "cross-env DATABASE_URL=file:./validate-only.db prisma validate --schema prisma/schema.sqlite.prisma && cross-env DATABASE_URL=postgresql://validate:only@localhost:5432/validate prisma validate --schema prisma/schema.postgres.prisma",
    "prisma:generate:test": "node scripts/compose-schema.mjs __test__/schema.header.prisma prisma/schema.sqlite.prisma __test__/schema.prisma && prisma generate --schema __test__/schema.prisma",
    "build:types": "tsc --project tsconfig.types.json",
    "prepack": "yarn build:types",
    "postpack": "node -e \"require('node:fs').rmSync('types', { recursive: true, force: true })\""
  },
  "peerDependencies": {
    "@prisma/client": "^6.5.0",
    "@time-fit/core": ">=0.0.0 <1"
  },
  "devDependencies": {
    "@prisma/client": "6.10.0",
    "@time-fit/core": "workspace:*",
    "@time-fit/integrations": "workspace:*",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "prisma": "^6.5.0",
    "typescript": "^5.9.3"
  }
}
