    "prisma:generate:test": "prisma generate --schema __test__/schema.prisma"
  },
  "peerDependencies": {
    "@prisma/client": "^6.5.0",
    "@time-fit/core": ">=0.0.0 <1"
  },
  "devDependencies": {
    "@prisma/client": "6.10.0",
    "@time-fit/core": "workspace:*",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "prisma": "^6.5.0"
  }
}
