// Merge these models into an application's SQLite Prisma schema, then generate the
// application's client. @time-fit/storage-prisma never generates or owns that client.
generator client { provider = "prisma-client-js" }
datasource db { provider = "sqlite"; url = env("DATABASE_URL") }

model Participant {
  id         String @id
  timeZone   String
  attributes Json?
}

model Task {
  id          String   @id
  spec        Json
  activeFrom  DateTime?
  activeUntil DateTime?
}

model Decision {
  decisionId String    @id
  state      String
  claimToken String
  claimedAt  DateTime
  finishedAt DateTime?
  error      Json?
  record     Json
}

model Gap {
  id     Int      @id @default(autoincrement())
  from   DateTime
  to     DateTime
  tickId String
}
