// Merge these models into an application's PostgreSQL Prisma schema, then generate the
// application's client. Keep the model names used by createPrismaStorage unchanged.
generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

model Participant {
  id         String @id
  timeZone   String
  attributes Json?
}

model Task {
  id          String   @id
  spec        Json
  activeFrom  DateTime?
  activeUntil DateTime?
}

model Decision {
  decisionId String    @id
  state      String
  claimToken String
  claimedAt  DateTime
  finishedAt DateTime?
  error      Json?
  record     Json
}

model Gap {
  id     Int      @id @default(autoincrement())
  from   DateTime
  to     DateTime
  tickId String
}
