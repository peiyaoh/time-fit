{
  "name": "time-fit",
  "version": "0.1.0",
  "type": "module",
  "license": "BSD-3-Clause",
  "workspaces": [
    "packages/*",
    "apps/*",
    "contrib/legacy/*",
    "contrib/legacy/fitbit-break"
  ],
  "scripts": {
    "example1": "node ./apps/take-a-break/index.js",
    "test": "yarn workspace @time-fit/storage-prisma prisma:generate:test && cross-env TZ=America/New_York NODE_OPTIONS=--experimental-vm-modules jest",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "build:types": "yarn workspaces foreach -A --include '@time-fit/core' --include '@time-fit/storage-prisma' --include '@time-fit/integrations' run build:types",
    "check:licenses": "node scripts/check-published-dependency-licenses.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "cross-env": "^7.0.3",
    "dependency-cruiser": "^16.10.4",
    "jest": "^29.7.0",
    "prisma": "^6.5.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "yarn@4.13.0"
}
